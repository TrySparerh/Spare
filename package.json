  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.30.1",
    "serve": "^14.2.4",
