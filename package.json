{
  "name": "spare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "warn"
    }
  },
  "scripts": {
