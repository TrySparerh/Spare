# SPARE engine API and workers — every value has a working local default.
# Blank values count as unset. This process never signs: the keeper is its own
# service (`bun run keeper`, src/keeper/config.ts) and the only one with a key.

NODE_ENV=development
PORT=4100

# infra/docker-compose.yml (Timescale pg16 on 5434, Redis 7 on 6381)
DATABASE_URL=postgres://spare:spare_dev@localhost:5434/spare
REDIS_URL=redis://localhost:6381

# 4663 = Robinhood Chain mainnet; 31337 = a LOCAL anvil fork of it
#   anvil --fork-url https://rpc.mainnet.chain.robinhood.com --chain-id 31337
CHAIN_ID=4663
# Defaults: 4663 -> https://rpc.mainnet.chain.robinhood.com (public, rate-limited)
#           31337 -> http://127.0.0.1:8545
RPC_URL=

# Address book. Default ../contracts/addresses/<CHAIN_ID>.json (relative to engine/).
# ADDRESSES_JSON (inline JSON) wins — use it on hosts that build engine/ alone.
ADDRESSES_FILE=
ADDRESSES_JSON=

# L2 blocks an accrual range must trail the head by (SweepExecutor.finalityBuffer).
FINALITY_BUFFER=3000

# Comma-separated origins. Production allows exactly these.
CORS_ORIGINS=https://trysparerh.com,http://localhost:8080

# The keeper's public address: the detailed health check shows it and reads
# whether it is registered on SweepExecutor and CashPark. Never set KEEPER_PK
# here (the API warns at boot if it is present).
KEEPER_ADDRESS=
# What the keeper service runs with, for the health report only.
KEEPER_BROADCAST=0
# Bearer token (32+ characters) for the detailed tRPC `health` procedure.
# Unset, every caller gets the public snapshot only (as GET /health).
HEALTH_TOKEN=

# --- keeper service (`bun run keeper`, its own process) -------------------------
# KEEPER_PK lives on the keeper service only, never here. 0 = simulate its
# transactions only (default), 1 = broadcast, which on 4663 sends real
# transactions with the keeper key (docs/RUNBOOK.md). Every knob and its default
# is in src/keeper/config.ts. A few worth knowing, at their defaults:
# /health listens on HOST:PORT. "::" is dual-stack, which an IPv6 private
# network needs; 0.0.0.0 would be IPv4 only.
# HOST=::
# A pool's $1 quote may sit at most its fee + this many bps under the oracle.
# The equity feeds post only on a 50 bps move or every 24 h; 60 = that + 10.
# QUOTE_ORACLE_ALLOWANCE_BPS=60
# No full-size quote more than this many bps under the oracle becomes a limit.
# QUOTE_MAX_SHORTFALL_BPS=120
# After an isolated (whale) sweep, its assets wait until their $1 quote is back
# within this many bps of its value before the sweep (at most 4 h).
# SWEEP_RECOVERY_BPS=10
# SWEEP_RECOVERY_MAX_MS=14400000
# Hooked pools (MU, GME): built-in pins in src/keeper/hooks.ts. HOOK_PINS (a
# JSON array of pins) replaces them, on the keeper and the monitor alike.
# HOOK_PINS=

# --- workers --------------------------------------------------------------------
# Run the workers inside the API process (dev convenience).
START_WORKERS=0
# Subset of workers for `bun run workers` (comma list), default all registered.
WORKERS=

# --- RPC budget -----------------------------------------------------------------
LOGS_MAX_RANGE=2000000
# getLogs calls per rule.preview REQUEST, all wallets, splits and retries included
PREVIEW_MAX_CHUNKS=250
PREVIEW_MAX_LOGS=20000
PREVIEW_TIMEOUT_MS=20000
PREVIEW_MAX_INFLIGHT=4
# ...and at most this many from one client (IPv4 address or IPv6 /64)
PREVIEW_MAX_INFLIGHT_PER_CLIENT=1
