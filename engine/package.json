{
  "name": "@spare/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "workers": "bun run src/workers/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "abis:sync": "bun run scripts/sync-abis.ts",
    "deploy:local": "bun run scripts/deploy-local.ts",
    "keeper": "bun run src/keeper/run.ts",
    "monitor": "bun run src/monitor/run.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.19.0",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.11",
    "ioredis": "5.11.1",
    "postgres": "3.4.9",
    "viem": "2.57.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
