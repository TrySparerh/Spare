# npm settings for spare-api (server/ is its own npm project; the root .npmrc
# does not apply here).
#
# ignore-scripts: dependency install/postinstall scripts never run.
ignore-scripts=true

# min-release-age (npm >= 11.10, see packageManager): `npm install` / `npm update`
# only pick versions published at least 3 days ago; `npm ci` installs the
# lockfile as-is. npm older than 11.10 does NOT honour the cooldown: it prints
# "Unknown project config min-release-age" and ignores the key, and
# package.json's devEngines (onFail "warn") adds an EBADDEVENGINES warning, but
# install, build and test still run. Add or update dependencies only with
# npm >= 11.10 (Node 24.21.0 from .nvmrc ships npm 11.19.0).
min-release-age=3
