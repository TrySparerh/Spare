# =============================================================================
# SPARE API — Robinhood Chain (chainId 4663)
# =============================================================================
# Copy to .env and fill in. NEVER commit .env.
# Only the names below are read.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
# Unset = production.
NODE_ENV=production
# true = also allow the local dev origins (localhost:5173 etc.) for CORS.
TEST_MODE=false
# Where GET / redirects; also allowed for CORS.
FRONTEND_URL=https://trysparerh.com

# -----------------------------------------------------------------------------
# Robinhood Chain
# -----------------------------------------------------------------------------
# Leave unset to use the public RPC (rpc.mainnet.chain.robinhood.com), or set a
# provider URL. A keyed URL never appears in a response or a log line.
RHC_RPC_URL=
# Optional dedicated RPC for every chain read (/api/spare, spare_* tools,
# /health, the $SPARE holder snapshot). Falls back to RHC_RPC_URL, then the
# public RPC.
SPARE_RPC_URL=
# Optional address-book override (contracts/addresses/<chain>.json shape),
# e.g. to point a staging API at a mainnet fork. Unset = the live mainnet deploy.
SPARE_ADDRESSES_JSON=
# Mirror of the keeper's MARKET_HOURS_GATE (default 1 = on). Set 0 here ONLY if
# the keeper runs with MARKET_HOURS_GATE=0; it decides when prices read "LIVE"
# and when spare_quote says a sweep would buy.
SPARE_MARKET_HOURS_GATE=1

# -----------------------------------------------------------------------------
# $SPARE token — NOT LAUNCHED
# -----------------------------------------------------------------------------
# Leave unset until the CA is published on trysparerh.com / x.com/TrySpareRH /
# t.me/sparerh. While unset, every token endpoint reports launched=false and
# every wallet is tier "standard".
SPARE_TOKEN_ADDRESS=
# Holder tier floors in whole $SPARE (only used once the token is live).
SPARE_TIER_HOLDER_MIN=5000
SPARE_TIER_WHALE_MIN=50000
SPARE_TIER_OG_MIN=500000

# -----------------------------------------------------------------------------
# CORS — extra origins beyond trysparerh.com (comma-separated)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=
