# npm settings for the root app (the site). The hosting platform's `npm ci` for
# the site and CI read this file. server/ is its own npm project and needs its own .npmrc.
#
# ignore-scripts: dependency install/postinstall scripts never run. Proven not
# needed here: `npm ci --ignore-scripts && npm run build` and the unit tests pass.
# esbuild and @swc/core load their binaries from their per-platform packages;
# keccak, bufferutil and utf-8-validate ship prebuilds and fall back to JS.
# Explicit `npm run <script>` / `npm start` / `npm test` still run; only
# pre/post hooks are skipped.
ignore-scripts=true

# min-release-age (npm >= 11.10, see packageManager): `npm install` / `npm update`
# only pick versions published at least 3 days ago, so a hijacked release is
# usually caught and yanked first. `npm ci` installs the lockfile as-is and is
# unaffected. npm older than 11.10 does NOT honour the cooldown: it prints
# "Unknown project config min-release-age" and ignores the key, and
# package.json's devEngines (onFail "warn") adds an EBADDEVENGINES warning, but
# install, build and test still run. Add or update dependencies only with
# npm >= 11.10 (Node 24.21.0 from .nvmrc ships npm 11.19.0).
min-release-age=3
