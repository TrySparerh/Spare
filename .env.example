# Spare frontend (Vite) — copy to .env.local and fill in what you need.
# Every VITE_* value is inlined into the public bundle: never put a secret here.

# Spare API root (spare-api: /health, /api/mcp/tools, /mcp, /api/spare/*), no trailing /api.
# Leave unset in dev to use http://localhost:3001; run spare-api locally and point here if needed.
VITE_API_URL=https://api.trysparerh.com

# Robinhood Chain mainnet (chain 4663) RPC.
VITE_RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# $SPARE token address. Leave empty until the token exists: every CA surface renders "SOON".
VITE_SPARE_CA=

# WalletConnect Cloud project id (enables the WalletConnect connector). Empty = injected wallets only.
VITE_WC_PROJECT_ID=

# Spline scene for the BIOS screen (empty = the built-in Spare scene).
VITE_SPLINE_SCENE=

# Optional overrides (empty = built-in defaults):
# VITE_SPLINE_LOGIN_SCENE=
# VITE_SPLINE_DESKTOP_SCENE=
# VITE_SPLINE_VIEWER=
# VITE_SPARE_FUND_FEE_BPS=25

# Phone-native (portrait 9:16) Spline scenes — phones (< 768px) only; desktop/tablet ignore them.
# Empty = the portrait video loop / poster in public/brand/mobile. See src/lib/mobileScenes.ts.
# VITE_SPLINE_BIOS_SCENE_MOBILE=
# VITE_SPLINE_LOGIN_SCENE_MOBILE=
# VITE_SPLINE_DESKTOP_SCENE_MOBILE=
